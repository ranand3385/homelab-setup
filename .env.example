# Copy to .env and fill in real values: cp .env.example .env

TZ=Etc/UTC

# Gluetun VPN (WireGuard); provider name per Gluetun's docs
VPN_SERVICE_PROVIDER=
WIREGUARD_PRIVATE_KEY=

# *arr API keys
SONARR_API_KEY=
RADARR_API_KEY=

# qBittorrent WebUI
QBIT_USER=admin
QBIT_PASS=

# CouchDB (Obsidian LiveSync)
COUCHDB_USER=
COUCHDB_PASSWORD=

# Tailscale sidecar for Actual Budget
TS_AUTHKEY=
TS_HOSTNAME=

# Pi-hole web UI
PIHOLE_WEBPASSWORD=

# Ports. Container side reuses the same value, so it must match the app's own listen port.
JELLYFIN_PORT=
QBIT_WEBUI_PORT=
TORRENT_PORT=
RADARR_PORT=
SONARR_PORT=
PROWLARR_PORT=
JELLYSEERR_PORT=
WIREGUARD_PORT=
FLARESOLVERR_PORT=
SEADEXERR_PORT=
COUCHDB_PORT=
ACTUAL_PORT=
BAZARR_PORT=
BAZARR_CONTAINER_PORT=
