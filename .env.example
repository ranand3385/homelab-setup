# Copy to .env and fill in real values: cp .env.example .env

TZ=Etc/UTC

# Gluetun VPN (WireGuard); provider name per Gluetun's docs
VPN_SERVICE_PROVIDER=
WIREGUARD_PRIVATE_KEY=

# Ports. Container side reuses the same value, so it must match the app's own listen port.
JELLYFIN_PORT=
QBIT_WEBUI_PORT=
TORRENT_PORT=
RADARR_PORT=
SONARR_PORT=
PROWLARR_PORT=
JELLYSEERR_PORT=
WIREGUARD_PORT=
